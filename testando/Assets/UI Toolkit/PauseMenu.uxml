<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="PauseRoot" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.75);">
        <ui:VisualElement style="background-color: rgb(30, 30, 40); padding: 30px; border-radius: 10px; align-items: center;">
            <ui:Label text="Pausado" style="font-size: 32px; color: white; margin-bottom: 24px; -unity-font-style: bold;" />

            <ui:Button name="SaveButton" text="Salvar Jogo" style="width: 220px; height: 46px; margin-bottom: 10px; font-size: 18px;" />
            <ui:Button name="LoadButton" text="Carregar Jogo" style="width: 220px; height: 46px; margin-bottom: 10px; font-size: 18px;" />
            <ui:Button name="BackToMenuButton" text="Voltar ao Menu" style="width: 220px; height: 46px; font-size: 18px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
